{
  "version": 2,
  "rungs_millions": [8, 25, 50, 120],
  "slices": ["pl_web", "pl_prose", "pl_wiki", "pl_dialogue", "pl_technical_legal", "en_web", "en_prose", "code"],
  "reference_tokens_per_slice": 150000,
  "minimum_out_of_mix_slices": 2,
